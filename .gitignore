# Nur TouchDeck (PC-Programm, Rust-Fassung und Android-App) gehört ins Repository.
/*
!/.gitignore
!/README.md
!/env.sh
!/touchdeck/
!/touchdeck-rs/
!/android/

# PC-Programm
touchdeck/node_modules/
touchdeck/data/
touchdeck/dist/
touchdeck/downloads/*.apk

# Rust-Fassung
touchdeck-rs/target/
touchdeck-rs/data/
touchdeck-rs/app/gen/

# Android-App (Signierschlüssel bleibt lokal!)
android/.gradle/
android/.kotlin/
android/.idea/
android/build/
android/app/build/
android/keystore/
android/local.properties
*.jks
*.keystore
