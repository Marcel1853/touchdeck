# Nur TouchDeck (PC-Programm und Android-App) gehört ins Repository.
/*
!/.gitignore
!/README.md
!/README.de.md
!/CHANGELOG.md
!/CHANGELOG.de.md
!/env.sh
!/touchdeck-rs/
!/android/

# Ideen und Notizen bleiben lokal (zusätzlich zur Liste oben).
docs/

# PC-Programm
touchdeck-rs/target/
touchdeck-rs/data/
touchdeck-rs/app/gen/
touchdeck-rs/downloads/*.apk
touchdeck-rs/.cache/

# Android-App (Signierschlüssel bleibt lokal!)
android/.gradle/
android/.kotlin/
android/.idea/
android/build/
android/app/build/
android/keystore/
android/local.properties
*.jks
*.keystore
