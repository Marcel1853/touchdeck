[
 {
  "type": "value_change",
  "category": "Werte",
  "label": "Wert ändert sich",
  "icon": "🏷️",
  "fields": [
   {
    "key": "name",
    "label": "Wert",
    "type": "dynamic",
    "source": "variables",
    "allowNew": true
   },
   {
    "key": "op",
    "label": "Wann?",
    "type": "select",
    "default": "any",
    "options": [
     {
      "value": "any",
      "label": "bei jeder Änderung"
     },
     {
      "value": "eq",
      "label": "wird gleich"
     },
     {
      "value": "ne",
      "label": "wird ungleich"
     },
     {
      "value": "gt",
      "label": "wird größer als"
     },
     {
      "value": "lt",
      "label": "wird kleiner als"
     },
     {
      "value": "contains",
      "label": "enthält"
     }
    ]
   },
   {
    "key": "value",
    "label": "Vergleichswert",
    "type": "text",
    "showIf": {
     "op": [
      "eq",
      "ne",
      "gt",
      "lt",
      "contains"
     ]
    }
   }
  ]
 },
