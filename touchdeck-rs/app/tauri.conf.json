{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TouchDeck",
  "mainBinaryName": "touchdeck",
  "version": "0.12.1",
  "identifier": "de.touchdeck.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Makro-Fernbedienung: Buttons am PC gestalten, vom Handy auslösen",
    "longDescription": "TouchDeck verwandelt Handy oder Tablet in ein Bedienfeld für den Linux-PC: Programme, Tastenkürzel, Medien, Lautstärke, Steam-Spiele, OBS Studio, Twitch und Discord per Knopfdruck.",
    "publisher": "Marcel",
    "homepage": "https://github.com/Marcel1853",
    "icon": ["icons/icon.png"],
    "resources": {
      "../web/": "web/",
      "../downloads/TouchDeck.apk": "downloads/TouchDeck.apk"
    },
    "linux": {
      "deb": {
        "depends": ["xdg-utils", "libxtst6", "libnotify-bin"],
        "postInstallScript": "after-install.sh",
        "postRemoveScript": "after-remove.sh"
      }
    }
  }
}
